# ──────────────────────────────────────────────────────────────
#  Ghostty — tuned for Claude Code on macOS (Ghostty 1.3.1)
#  Reload after edits:  ⌘⇧,    Validate:  ghostty +validate-config
#  Browse themes:       ghostty +list-themes
# ──────────────────────────────────────────────────────────────

# ── Typography ────────────────────────────────────────────────
# JetBrainsMono Nerd Font Mono — fixed-width glyphs so Claude Code,
# starship, btop, git icons all align. (installed via brew cask)
font-family             = JetBrainsMono NFM
font-size               = 14
font-thicken            = true
# Coding ligatures stay on (==>  !=  =>). Comment out the next line to kill them.
# font-feature           = -calt -liga -dlig
# A touch more line height = far easier to scan long Claude Code diffs.
adjust-cell-height      = 12%

# ── Theme & color ─────────────────────────────────────────────
# Auto-follows macOS appearance. Deep-navy dark (matches the
# "pilot dashboard" look); warm Latte in the day.
theme                   = light:Catppuccin Latte,dark:TokyoNight Night
window-colorspace       = display-p3
background-opacity      = 0.82
background-blur-radius  = 40
unfocused-split-opacity = 0.7

# ── Window & layout ───────────────────────────────────────────
# Big canvas: room for code blocks + side-by-side diffs.
window-width            = 180
window-height           = 50
window-padding-x        = 14
window-padding-y        = 10
window-padding-balance  = true
window-save-state       = always
macos-titlebar-style    = tabs
window-inherit-working-directory = true
window-inherit-font-size = true
# Don't nag when closing a pane that's just running a shell.
confirm-close-surface   = false
quit-after-last-window-closed = false

# ── Cursor & mouse ────────────────────────────────────────────
cursor-style            = block
cursor-style-blink      = false
mouse-hide-while-typing = true
copy-on-select          = clipboard
# ⌘-click file paths & URLs in Claude Code output.
link-url                = true

# ── Claude Code essentials ────────────────────────────────────
# Make BOTH Option keys send real Alt/Esc — required for Claude Code
# word-nav (⌥←/→) and option-based keybinds. Without this they break.
macos-option-as-alt     = true
# Long agent runs scroll a lot — keep deep history.
scrollback-limit        = 100000000
# Safety: confirm pasted multi-line / control content (Claude pastes a lot).
clipboard-paste-protection = true
clipboard-read          = allow
clipboard-write         = allow

# ── Shell integration (zsh) ───────────────────────────────────
shell-integration          = detect
shell-integration-features = cursor,sudo,title
# Jump between prompts: ⌘↑ / ⌘↓
keybind = super+up=jump_to_prompt:-1
keybind = super+down=jump_to_prompt:1

# ── Splits (vim-style nav) ────────────────────────────────────
# ⌘D / ⌘⇧D = split in the SAME folder you're in (routes via tmux so it
# inherits the current project dir). Then type `cc` for a new Claude chat there.
keybind = super+d=text:\x02|
keybind = super+shift+d=text:\x02-
keybind = super+alt+h=goto_split:left
keybind = super+alt+l=goto_split:right
keybind = super+alt+k=goto_split:up
keybind = super+alt+j=goto_split:down
keybind = super+shift+enter=toggle_split_zoom
keybind = super+alt+e=equalize_splits

# ── Quick terminal (drop-down, global) ────────────────────────
# ⌃` from anywhere to summon a Claude Code scratch terminal.
quick-terminal-position           = top
quick-terminal-screen             = macos-menu-bar
quick-terminal-autohide           = true
quick-terminal-animation-duration = 0.12
keybind = global:ctrl+grave_accent=toggle_quick_terminal

# ── Misc quality-of-life ──────────────────────────────────────
keybind = super+shift+comma=reload_config
keybind = super+shift+i=inspector:toggle
# ⌘V paste — explicit + performable so it also passes through to Claude Code
# for image paste (the known ⌘V-stops-after-2-pastes bug). Text paste unaffected.
keybind = performable:super+v=paste_from_clipboard
keybind = super+shift+v=paste_from_clipboard
# ── Cursor word-jump in Claude Code + shell ───────────────────
# Option+←/→ = jump one WORD; Option+Backspace = delete a word.
# (sends readline word-move sequences: ESC-b / ESC-f / ESC-DEL)
keybind = alt+left=text:\x1bb
keybind = alt+right=text:\x1bf
keybind = alt+backspace=text:\x1b\x7f
# ⌘←/→ = jump to start/end of the line; ⌘Backspace = delete to line start
keybind = super+left=text:\x01
keybind = super+right=text:\x05
keybind = super+backspace=text:\x15
# ── ⌘T = show the DASHBOARD (sends tmux prefix Ctrl-b + D) ─────
# New tab moves to ⌘⇧T. Dashboard launches/attaches the cockpit.
keybind = super+t=text:\x02D
keybind = super+shift+t=new_tab
auto-update               = check
